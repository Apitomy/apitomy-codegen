{
    "openapi": "3.1.0",
    "info": {
        "title": "Nullable Union Types Sample API",
        "version": "1.0.0"
    },
    "paths": {
        "/items": {
            "get": {
                "operationId": "getItems",
                "parameters": [
                    {
                        "name": "id",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "name",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": ["string", "null"]
                        }
                    },
                    {
                        "name": "count",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": ["integer", "null"]
                        }
                    },
                    {
                        "name": "tags",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": ["array", "null"],
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    {
                        "name": "labels",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "type": ["string", "null"]
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "ok"
                    }
                }
            },
            "post": {
                "operationId": "createItem",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": ["object", "null"],
                                "properties": {
                                    "name": {
                                        "type": ["string", "null"]
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "ok"
                    }
                }
            },
            "put": {
                "operationId": "replaceItem",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/Item"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "ok"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Item": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": ["string", "null"]
                    }
                }
            }
        }
    }
}
