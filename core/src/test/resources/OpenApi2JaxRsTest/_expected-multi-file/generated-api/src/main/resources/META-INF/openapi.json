{
    "openapi": "3.1.0",
    "info": {
        "title": "Multi File Sample API",
        "version": "1.0.0"
    },
    "paths": {
        "/pets": {
            "get": {
                "summary": "Get a pet",
                "operationId": "getPet",
                "responses": {
                    "200": {
                        "description": "Returns a pet.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Pet"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Pet": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "age": {
                        "format": "int32",
                        "type": "integer"
                    }
                }
            }
        }
    }
}